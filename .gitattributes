# Normalise to LF in the repository and in the working tree.
#
# These files are consumed by Linux tools -- make reads the Makefiles, sh runs
# the scripts, dtc reads the .dts -- and a stray CR in a shell script or make
# recipe fails on the build host in ways that look unrelated to line endings.
# Authoring happens on Windows, so this has to be stated rather than assumed.
* text=auto eol=lf

# Board product brief, 515 KB, not text.
*.pdf binary
