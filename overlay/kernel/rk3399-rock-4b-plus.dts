/*
 * Radxa ROCK 4B+ -- early hardware revision (V1.6 / V1.72)
 * Copyright (c) 2019 Akash Gajjar <Akash_Gajjar@mentor.com>
 * Copyright (c) 2019 Pragnesh Patel <Pragnesh_Patel@mentor.com>
 */

/*
 * This board is the same hardware as what Radxa used to call "ROCK Pi 4B Plus"
 * and now calls "ROCK 4B+". The 2022 rename dropped "Pi" from the product line
 * name; the model suffix is what distinguishes boards.
 *
 * This file is deliberately a thin delta on top of two upstream, hardware
 * verified files, rather than a from-scratch description:
 *
 *   rk3399-op1.dtsi        OP1 (RK3399-T) operating points, incl. A72 to 2016 MHz
 *   rk3399-rock-pi-4.dtsi   the whole 4A/4B family: RK808 PMIC, regulators,
 *                           gmac RGMII timing, ES8316 audio on i2s0, LEDs,
 *                           storage, USB, 40-pin pinctrl
 *
 * An earlier version of this port hand-wrote ~900 lines and guessed the PMIC
 * type, regulator topology, audio codec address, RGMII delays and headphone
 * GPIOs. Every one of those guesses was wrong or unavailable, and the result was
 * a board that booted the kernel but had no working power rail, no Ethernet and
 * no USB. Inheriting the upstream files removes that entire class of error.
 *
 * Verified upstream hardware facts this file relies on, from
 * rk3399-rock-pi-4.dtsi:
 *   - PMIC is RK808 at i2c0 0x1b, and the node lives INSIDE &i2c0
 *   - Ethernet PHY supply is vcc3v3_lan, RGMII tx_delay 0x28 / rx_delay 0x11
 *   - ES8316 is at i2c1 0x11, takes mclk from SCLK_I2S_8CH_OUT, sits on i2s0
 *   - headphone detect is gpio1_A0, codec interrupt is gpio1_A1
 *   - status LED (blue) is gpio3_PD5
 *
 * Board-specific to this revision:
 *   - V1.6/V1.72 have a 4 MB SPI flash populated, so SPI is left enabled in
 *     U-Boot for booting and for the environment. Later V1.73 boards ship with
 *     the SPI flash unpopulated.
 *     Note that this says U-Boot specifically. It used to be the whole story,
 *     and it was worth stating: the kernel had no &spi1 and no flash@0 node at
 *     all, so the flash that holds the bootloader was invisible to a running
 *     OpenWrt. See the &spi1 block at the end of this file.
 *   - RAM may be 2 GB or 4 GB; nothing in the device tree needs to change.
 */

/dts-v1/;
#include "rk3399-op1.dtsi"
#include "rk3399-rock-pi-4.dtsi"

/ {
	model = "Radxa ROCK 4B+";
	compatible = "radxa,rock-4b-plus", "radxa,rockpi4b-plus", "radxa,rockpi4", "rockchip,rk3399";

	aliases {
		mmc2 = &sdio0;
	};

	/*
	 * No gpio-keys node on purpose.
	 *
	 * An earlier revision guessed gpio4_B2 for the on-board button so that
	 * kmod-gpio-button-hotplug could see it. That guess was wrong and it was
	 * dropped: holding the button produces no change on any GPIO, and neither
	 * rk3399-rock-pi-4b-plus.dts nor Radxa's own rk3399-rock-pi-4b-plus.dts
	 * declares a gpio-keys node.
	 *
	 * The reason is that the button is not a Linux input. Per Radxa's
	 * documentation the on-board button is a *Maskrom* button, and maskrom
	 * mode is selected by the boot ROM sampling the pin at power-on: hold the
	 * button while applying power, and the ROM enters maskrom instead of
	 * loading the SPI flash. There is no Linux-visible event to describe.
	 *
	 * Leaving the node in would also permanently claim gpio4_B2, which the
	 * 40-pin header and expansion HATs may want.
	 *
	 * RESET and maskrom are likewise bootloader-level and need no DT nodes.
	 */
};

/*
 * IMPORTANT: including rk3399-rock-pi-4.dtsi is NOT equivalent to including
 * rk3399-rock-pi-4b-plus.dts. The dtsi carries only the shared 4A/4B plumbing;
 * the board file carries the four overrides below, and rk3399-base.dtsi ships
 * the affected controllers as status = "disabled". Dropping them is exactly
 * why WiFi was dead on the first boot: sdio0 stayed disabled, the power
 * sequence never ran, and the reset line (gpio0_B2) was left low with the
 * chip held in reset.
 */

/* SDIO WiFi (AP6256 / BCM43456) */
&sdio0 {
	status = "okay";

	brcmf: wifi@1 {
		compatible = "brcm,bcm4329-fmac";
		reg = <1>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA3 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "host-wake";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_host_wake_l>;
	};
};

/*
 * The WiFi power sequence must name its clock "ext_clock".
 *
 * rk3399-rock-pi-4.dtsi calls this clock "lpo", and uses that name consistently
 * for the Bluetooth node as well. But the only name the MMC power-sequence
 * driver ever looks up is "ext_clock":
 *
 *     pwrseq->ext_clk = devm_clk_get(dev, "ext_clock");
 *     if (IS_ERR(pwrseq->ext_clk) && PTR_ERR(pwrseq->ext_clk) != -ENOENT)
 *             return dev_err_probe(..., "external clock not ready\n");
 *
 * and drivers/mmc/core/pwrseq_simple.c then guards every use with
 * !IS_ERR(). So with the inherited name the lookup returns -ENODEV, that is
 * tolerated, the ERR_PTR is left in place, and the clock is silently never
 * enabled. No error, no warning -- the WiFi power-on just proceeds without it.
 * The binding agrees: mmc-pwrseq-simple.yaml declares clock-names as
 * `const: ext_clock` with additionalProperties: false.
 *
 * What that clock is: rk808 index 1 resolves to clkout2, the RK808 PMIC's
 * 32.768 kHz output, gated by CLK32KOUT2_EN in RK808_CLK32OUT_REG, with real
 * prepare/unprepare ops. Enabling it is what actually switches the 32 kHz output
 * on, and it happens between powering the card and releasing its reset.
 *
 * Why this matters here, and how it was found: Armbian runs the WiFi fine on this
 * same board, with the same brcmfmac driver and byte-identical firmware, NVRAM
 * and clm_blob. Its live device tree differs from ours in exactly one place in
 * the WiFi power path -- this property. Armbian names it "ext_clock"; upstream
 * Radxa names it "lpo"; the driver only honours the former.
 *
 * The symptom matches: the firmware uploads successfully and the chip then never
 * asserts HT_AVAIL, which is what a chip that came out of reset without its
 * low-power clock present would look like.
 *
 * This is a conformance fix, not a tuning value. See
 * docs/wifi.md section 0.
 */
&sdio_pwrseq {
	clock-names = "ext_clock";
};

/* Bluetooth on UART0 */
&uart0 {
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm4345c5";
		clocks = <&rk808 1>;
		clock-names = "lpo";
		device-wakeup-gpios = <&gpio2 RK_PD3 GPIO_ACTIVE_HIGH>;
		host-wakeup-gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_HIGH>;
		shutdown-gpios = <&gpio0 RK_PB1 GPIO_ACTIVE_HIGH>;
		max-speed = <1500000>;
		pinctrl-names = "default";
		pinctrl-0 = <&bt_host_wake_l &bt_wake_l &bt_enable_h>;
		vbat-supply = <&vcc3v3_sys>;
		vddio-supply = <&vcc_1v8>;
	};
};

/* Headphone jack detect: 4-ring 3.5 mm jack, microphone input by default */
&sound {
	hp-det-gpio = <&gpio1 RK_PA0 GPIO_ACTIVE_HIGH>;
};

&es8316 {
	pinctrl-0 = <&hp_detect &hp_int>;
	pinctrl-names = "default";
	interrupt-parent = <&gpio1>;
	interrupts = <RK_PA1 IRQ_TYPE_LEVEL_HIGH>;
};

/*
 * SPI NOR flash, 4 MB XT25F32B, on spi1.
 *
 * rk3399-base.dtsi defines spi1 with the right pinctrl already
 * (&spi1_clk &spi1_tx &spi1_rx &spi1_cs0) but leaves it disabled, and
 * rk3399-rock-pi-4.dtsi never touches it -- so without this the kernel has no
 * /dev/mtd0 and cannot see the flash that holds the bootloader.
 *
 * Why that matters beyond curiosity: if the SPI bootloader ever goes bad again,
 * being able to read and rewrite it from a running system is the difference
 * between a five-minute fix and a maskrom operation. It is also the only way to
 * tell, from software, whether the chip is actually populated -- V1.73 boards
 * ship without it, and their probe fails harmlessly with a log line.
 *
 * spi-max-frequency follows this port's U-Boot
 * (rk3399-rock-pi-4-u-boot.dtsi, 10 MHz) rather than upstream
 * rk3399-rock-pi-4b.dts's 108 MHz. The chip is a plain SPI NOR on a short
 * trace; 10 MHz costs nothing here and reads are what this node is for. Change
 * it only with evidence that a faster clock is needed.
 */
&spi1 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;
	};
};
